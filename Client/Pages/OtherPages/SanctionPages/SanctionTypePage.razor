@if (allState.ShowSanctionType)
{
    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="float-start">Yaptırım Türleri</h4>
                        <button class="btn btn-outline-success float-end" @onclick="OpenDialog">
                            <i class="bi bi-plus-circle-dotted"> </i>Tür Ekle
                        </button>
                    </div>
                    <div class="card-header" style="max-height:580px; overflow-x:hidden; overflow-y:scroll;">
                        <div class="card-body">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Id</th>
                                        <th scope="col">Tür</th>
                                        <th scope="col">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Types is not null)
                                    {
                                        int count = 1;
                                        foreach (var item in Types)
                                        {
                                            <tr>
                                                <th scope="row">@count</th>
                                                <td>@item.Id</td>
                                                <td>@item.Name</td>
                                                <td>
                                                    <i class="bi bi-pencil text-info" id="cursorStyle"
                                                       onclick="()=>EditClicked(item)"></i>
                                                    <i class="bi bi-trash text-danger" id="cursorStyle"
                                                       onclick="()=>DeleteClicked(item)"></i>
                                                </td>
                                            </tr>
                                            count++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4"><div class="alert alert-info text-center">Henüz tür eklenmemiş!</div></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .cursorStyle {
        cursor: pointer;
    }
</style>

<SanctionTypeDialog @ref="sanctionTypeDialog"
                    HandleSaveOperationEvent="HandleSaveOperationEvent"
                    SanctionType="SanctionType" />

@code {
    SanctionTypeDialog? sanctionTypeDialog;
    SanctionType SanctionType = new();
    public string Tİtle { get; set; } = "Ekle";
    public List<SanctionType> Types { get; set; } = new();

    protected async override Task OnInitializedAsync()
    {
        await GetTypes();
        allState.Action += StateHasChanged;
    }

    private async Task GetTypes() => Types = await sanctionTypeService.GetAll(Constants.SanctionTypeBaseUrl);

    void OpenDialog() => sanctionTypeDialog?.OpenDialog();

    //ekle veya güncelle
    private async Task HandleSaveOperationEvent(SanctionType item)
    {
        bool successCheck = false;
        if (item.Id > 0)
        {
            var result = await sanctionTypeService.Update(item, Constants.SanctionTypeBaseUrl);
            successCheck = await DisplayMessage(result.Flag, result.Message);
        }
        else
        {
            var response = await sanctionTypeService.Insert(item, Constants.SanctionTypeBaseUrl);
            successCheck = await DisplayMessage(response.Flag, response.Message);
        }
        if (successCheck)
        {
            SanctionType = new();
            await GetTypes();
            sanctionTypeDialog?.ChangeTitle("Ekle");
        }
    }

    private void EditClicked(SanctionType item)
    {
        sanctionTypeDialog?.ChangeTitle("Güncelle");
        SanctionType = item;
        OpenDialog();
    }

    private async Task DeleteClicked(SanctionType item)
    {
        bool confirm = await dialogService.ConfirmAsync("Silmek istediğinizden emin misiniz?", "Silme İşlemini Onayla");
        if (!confirm) return;

        var response = await sanctionTypeService.DeleteById(item.Id, Constants.SanctionTypeBaseUrl);
        var result = await DisplayMessage(response.Flag, response.Message);
        if (result)
            await GetTypes();
    }


    private async Task<bool> DisplayMessage(bool flag, string message)
    {
        if (flag)
        {
            await dialogService.AlertAsync(message, "İşlem Başarılı");
            return true;
        }
        else
        {
            await dialogService.AlertAsync(message, "Hata!");
            return false;
        }
    }

    public void Dispose()
    {
        allState.Action -= StateHasChanged;
    }
}
