@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

<AuthorizeView>
    <Authorized>
        <div class="profile-dropdown">
            <div class="btn-group">
                <button type="button" class="btn btn-link p-0 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="profile-button">
                        <img src="@(ProfileImage == "" ? "../images/profile/defaultprofileimage.jpg" : ProfileImage)"
                             alt="Profile" class="profile-image" />
                        <i class="bi bi-chevron-down ms-2"></i>
                    </div>
                </button>

                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                    <li>
                        <div class="profile-card">
                            <!-- Profile Header -->
                            <div class="profile-header">
                                <img src="@(ProfileImage == "" ? "../images/profile/defaultprofileimage.jpg" : ProfileImage)"
                                     alt="Profile" class="profile-avatar" />
                                <div class="profile-info">
                                    <h6 class="mb-0">@UserName</h6>
                                    <small class="text-muted">@UserEmail</small>
                                </div>
                            </div>

                            <!-- Menu Items -->
                            <div class="profile-menu">
                                <a href="/profile" class="profile-menu-item">
                                    <i class="bi bi-person-gear me-2"></i>
                                    Profil
                                </a>
                                <a href="/settings" class="profile-menu-item">
                                    <i class="bi bi-gear me-2"></i>
                                    Ayarlar
                                </a>
                                <div class="dropdown-divider"></div>
                                <button class="profile-menu-item logout-btn" @onclick="LogoutClicked">
                                    <i class="bi bi-box-arrow-left me-2"></i>
                                    Çıkış Yap
                                </button>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="login-section">
            <button type="button" class="login-btn" @onclick="NavigateToLogin">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Giriş Yap
            </button>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .profile-dropdown {
        position: relative;
    }

    .profile-button {
        display: flex;
        align-items: center;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0.25rem;
        border-radius: 50px;
        transition: all 0.3s ease;
    }

    .profile-button:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    .profile-image {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(255, 255, 255, 0.3);
        transition: all 0.3s ease;
    }

    .btn-group .btn:focus {
        box-shadow: none;
    }

    .dropdown-toggle::after {
        display: none;
    }

    .dropdown-menu {
        min-width: 280px;
        padding: 0;
        margin-top: 0.5rem;
        border-radius: 12px;
        background: white;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    }

    .profile-card {
        padding: 0;
        border-radius: 12px;
        overflow: hidden;
    }

    .profile-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 1.25rem;
        display: flex;
        align-items: center;
        color: white;
    }

    .profile-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid rgba(255, 255, 255, 0.3);
        margin-right: 1rem;
    }

    .profile-info h6 {
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .profile-info small {
        opacity: 0.9;
        font-size: 0.8rem;
    }

    .profile-menu {
        padding: 0.5rem 0;
    }

    .profile-menu-item {
        display: flex;
        align-items: center;
        width: 100%;
        padding: 0.75rem 1.25rem;
        color: #374151;
        text-decoration: none;
        background: none;
        border: none;
        font-size: 0.9rem;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .profile-menu-item:hover {
        background: #f3f4f6;
        color: #1f2937;
    }

    .profile-menu-item i {
        width: 18px;
        text-align: center;
        opacity: 0.7;
    }

    .logout-btn {
        color: #dc2626 !important;
        font-weight: 500;
    }

    .logout-btn:hover {
        background: #fef2f2 !important;
        color: #b91c1c !important;
    }

    .logout-btn i {
        opacity: 1;
    }

    .dropdown-divider {
        margin: 0.5rem 0;
        border-top: 1px solid #e5e7eb;
    }

        .profile-avatar {
            width: 45px !important;
            height: 45px !important;
        }
    }

    .login-section {
        display: flex;
        align-items: center;
    }

    .login-btn {
        display: flex;
        align-items: center;
        padding: 0.65rem 1.5rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        text-decoration: none;
        border-radius: 25px;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        position: relative;
        overflow: hidden;
    }

    .login-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s;
    }

    .login-btn:hover::before {
        left: 100%;
    }

    .login-btn:hover {
        background: linear-gradient(135deg, #5a67d8 0%, #6b46c1 100%);
        color: white;
        text-decoration: none;
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6);
    }

    .login-btn:active {
        transform: translateY(0);
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .login-btn i {
        font-size: 1rem;
        transition: transform 0.3s ease;
    }

    .login-btn:hover i {
        transform: translateX(2px);
    }

</style>

@code {
    public string ProfileImage { get; set; } = "";
    public string UserName { get; set; } = "";
    public string UserEmail { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfo();
    }

    private async Task LoadUserInfo()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState?.User?.Identity?.IsAuthenticated == true)
            {
                UserName = authState.User.Identity.Name ?? "Kullanıcı";

                UserEmail = authState.User.FindFirst("email")?.Value ??
                           authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ??
                           authState.User.FindFirst("preferred_username")?.Value ??
                           "email@example.com";
            }
            else
            {
                UserName = "Misafir";
                UserEmail = "";
            }
        }
        catch (Exception ex)
        {
            UserName = "Kullanıcı";
            UserEmail = "";
            Console.WriteLine($"LoadUserInfo Error: {ex.Message}");
        }
    }

    private async Task NavigateToLogin()
    {
        try
        {
            Console.WriteLine("Giriş butonuna tıklandı!");
            Console.WriteLine($"Mevcut URL: {NavManager.Uri}");

            await JSRuntime.InvokeVoidAsync("window.location.href", "/identity/account/login");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"JSRuntime yönlendirme hatası: {ex.Message}");

            var loginUrls = new[]
            {
                "/identity/account/login",
                "/Account/Login",
                "/login",
                "/authentication/login",
                "/Identity/Account/Login" 
            };

            foreach (var url in loginUrls)
            {
                try
                {
                    Console.WriteLine($"Denenen URL: {url}");
                    NavManager.NavigateTo(url, forceLoad: true);
                    break; 
                }
                catch (Exception navEx)
                {
                    Console.WriteLine($"{url} URL'si çalışmadı: {navEx.Message}");
                }
            }
        }
    }

    async Task LogoutClicked()
    {
        try
        {
            var logoutModel = new UserSession();
            var customAuthStateProvider = (CustomAuthenticationStateProvider)AuthStateProvider;
            await customAuthStateProvider.UpdateAuthenticationState(logoutModel);
            NavManager.NavigateTo("/identity/account/login", replace: true, forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logout Error: {ex.Message}");

            NavManager.NavigateTo("/identity/account/login", replace: true, forceLoad: true);
        }
    }
}