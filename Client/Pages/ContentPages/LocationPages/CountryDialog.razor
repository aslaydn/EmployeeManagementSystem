<SfDialog Width="280px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsVisible">
    <DialogEvents OnOpen="OpenDialog"> </DialogEvents>
    <DialogTemplates>
        <Header> Ülkeyi @Title</Header>
        <Content>
            <EditForm Model="Country" Enhance OnSubmit="Save">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label">Id</label>
                            <input @bind="Country.Id" class="form-control" disabled />
                        </div>
                        <div class="form-group">
                            <label class="form-label">İsim</label>
                            <InputText @bind-Value="Country.Name" class="form-control" />
                        </div>
                    </div>
                </div>
            </EditForm>
        </Content>
    </DialogTemplates>

    <DialogButtons>
        <DialogButton Content="KAYDET" Type="ButtonType.Submit" IsPrimary="true" OnClick="Save"></DialogButton>
    </DialogButtons>
</SfDialog>

@code {
    [Parameter] public Country Country { get; set; } = new();
    [Parameter] public EventCallback<Country> HandleSaveOperationEvent { get; set; }
    private bool IsVisible { get; set; } = false;
    public string Title { get; set; } = "Ekle";
    private async void Save()
    {
        if (string.IsNullOrEmpty(Country.Name))
            await dialogService.AlertAsync("Lütfen ilgili yerleri boş bırakmayın.", "Uyarı!");
        else
            await HandleSaveOperationEvent.InvokeAsync(Country);
    }

    public void OpenDialog()
    {
        IsVisible = true;
        StateHasChanged();
    }

    public void ChangeTitle(string title)
    {
        Title = title;
    }
}
