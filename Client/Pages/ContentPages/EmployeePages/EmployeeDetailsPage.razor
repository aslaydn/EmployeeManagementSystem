@if (ShowDetailsPage)
{
    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="card border-success shadow-lg">
                    <div class="card-header">@EmployeeDetails.Name Detaylar</div>
                    <div class="div-body">
                        <div class="hstack gap-2">
                            <div class="vstack gap-3">
                                <img src="@EmployeeDetails.Photo" class="card-img-top border-warning shadow-sm"
                                     style="width:100px; height:100px; border-radius:50%;" />
                                <table class="table border-danger">
                                    <tbody>
                                        <tr>
                                            <td><h6 class="fw-bold">İsim:</h6></td>
                                            <td>@EmployeeDetails.Name</td>
                                        </tr>
                                        <tr>
                                            <td><h6 class="fw-bold">Pozisyon:</h6></td>
                                            <td>@EmployeeDetails.JobName</td>
                                        </tr>
                                        <tr>
                                            <td><h6 class="fw-bold">Telefon:</h6></td>
                                            <td>@EmployeeDetails.TelephoneNumber</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <table class="table border-primary">
                                <tbody>
                                    <tr>
                                        <td colspan="2" class="text-center"><h6 class="fw-bold">Departman Bilgileri</h6></td>
                                    </tr>
                                    <tr>
                                        <td><h6 class="fw-bold">Genel Departman:</h6></td>
                                        <td>@EmployeeDetails.Branch!.Department!.GeneralDepartment!.Name</td>
                                    </tr>
                                    <tr>
                                        <td><h6 class="fw-bold">Departman:</h6></td>
                                        <td>@EmployeeDetails.Branch!.Department!.Name</td>
                                    </tr>
                                    <tr>
                                        <td><h6 class="fw-bold">Birim:</h6></td>
                                        <td>@EmployeeDetails.Branch!.Name</td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table border-success">
                                <tbody>
                                    <tr>
                                        <td colspan="2" class="text-center"><h6 class="fw-bold">Konum Bilgileri</h6></td>
                                    </tr>
                                    <tr>
                                        <td><h6 class="fw-bold">Ülke:</h6></td>
                                        <td>@EmployeeDetails.Town!.City!.Country!.Name</td>
                                    </tr>
                                    <tr>
                                        <td><h6 class="fw-bold">Şehir:</h6></td>
                                        <td>@EmployeeDetails.Town!.City!.Name</td>
                                    </tr>
                                    <tr>
                                        <td><h6 class="fw-bold">İlçe:</h6></td>
                                        <td>@EmployeeDetails.Town!.Name</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-danger" @onclick="DetailsPageCloseBtnClicked">Kapat</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool ShowDetailsPage { get; set; }
    [Parameter] public Employee EmployeeDetails { get; set; } = new();
    [Parameter] public EventCallback HandleDetailsPageCloseBtnClicked { get; set; } 

    async Task DetailsPageCloseBtnClicked() => await HandleDetailsPageCloseBtnClicked.InvokeAsync();
}
