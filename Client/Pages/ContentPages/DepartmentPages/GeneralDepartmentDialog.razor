<SfDialog Width="350px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsVisible">
    <DialogEvents OnOpen="OpenDialog"> </DialogEvents>
    <DialogTemplates>
        <Header>Departmanı @Title</Header>
        <Content>
            <EditForm Model="GeneralDepartment" Enhance OnSubmit="Save">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label">İsim</label>
                            <InputText class="form-control" @bind-Value="GeneralDepartment.Name" />
                        </div>
                    </div>
                </div>
            </EditForm>
        </Content>
    </DialogTemplates>

    <DialogButtons>
        <DialogButton Content="KAYDET" Type="ButtonType.Submit" IsPrimary="true" OnClick="Save" />
    </DialogButtons>
</SfDialog>

@code {
    [Parameter] public GeneralDepartment GeneralDepartment { get; set; } = new();
    [Parameter] public EventCallback<GeneralDepartment> HandleSaveOperationEvent { get; set; }
    private bool IsVisible { get; set; } = false;
    public string Title { get; set; } = "Ekle";

    public void OpenDialog()
    {
        IsVisible = true;
        StateHasChanged();
    }

    async void Save()
    {
        if (string.IsNullOrEmpty(GeneralDepartment.Name))
            await dialogService.AlertAsync("Lütfen departman adını giriniz.", "Uyarı!");
        else
            await HandleSaveOperationEvent.InvokeAsync(GeneralDepartment);
    }

    public void ChangeTitle(string title)
    {
        Title = title;
    }
}
